# Copy to .env for scripts/Start-Local.ps1; never commit the real .env.
ADMIN_USERNAME=admin
# REQUIRED: at least 12 characters; Start-Local.ps1 generates a random password when .env does not exist.
ADMIN_PASSWORD=
# Use HTTPS and enable this in production, not on local HTTP.
COOKIE_SECURE=false

# Optional: keep H2 unless you have manually created and validated your MySQL database.
# Follow docs/mysql-redis-setup.md. This URL is for local loopback development ONLY.
# DB_URL=jdbc:mysql://127.0.0.1:3306/cloud_novel?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=DISABLED&allowPublicKeyRetrieval=true
# DB_USERNAME=cloud_novel_app
# DB_PASSWORD=
# DB_INIT_MODE=never
# BOOK_STORAGE=./data/books
