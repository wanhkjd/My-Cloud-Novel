# Runtime configuration: MySQL + Redis are required; there is no embedded database fallback.
# Prefer scripts/Prepare-LocalEnvironment.ps1 to generate private files without changing any service.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=false

# Loopback development only. Remote MySQL must use verified TLS.
DB_URL=jdbc:mysql://127.0.0.1:3306/cloud_novel?characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=DISABLED&allowPublicKeyRetrieval=true
DB_USERNAME=cloud_novel_app
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_NAMESPACE=cloud-novel:session
REDIS_SSL=false
BOOK_STORAGE=./data/books
