# 配置模板：复制为同目录 application-dev.yml 后填入真实取值。
# application-dev.yml 已被 git 忽略，私有凭据不会进入版本库。
cloudnovel:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: 127.0.0.1
    port: 3306
    database: cloud_novel
    username: cloud_novel_app
    password: replace-with-private-database-password
  admin:
    username: admin
    password: replace-with-at-least-12-character-admin-password
  storage-directory: ./data/books
  # 上传体积上限，可按部署环境灵活调整；缺省即 application.yml 内置的 30MB / 31MB。
  # Spring 的 MB 按 1024 进制解析，故 30MB 即 30 MiB；请求上限略大于文件上限以容纳 multipart 头部。
  upload:
    max-file-size: 30MB
    max-request-size: 31MB
