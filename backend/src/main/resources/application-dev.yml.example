# 配置模板：复制为同目录 application-dev.yml 后填入真实取值。
# application-dev.yml 已被 git 忽略，私有凭据不会进入版本库。
cloudnovel:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: 127.0.0.1
    port: 3306
    database: cloud_novel
    username: cloud_novel_app
    password: replace-with-private-database-password
  redis:
    host: 127.0.0.1
    port: 6379
    username: ""
    password: replace-with-private-redis-password
    database: 0
  admin:
    username: admin
    password: replace-with-at-least-12-character-admin-password
  storage-directory: ./data/books
