{
  "name": "my-cloud-novel-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\" \"testing/**/*.ts\" \"*.{ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\" \"testing/**/*.ts\" \"*.{ts,json,html}\""
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.0"
  }
}
